#set page(
  margin: (right: 15mm, left: 30mm, top: 20mm, bottom: 20mm),
  numbering: "1"
)

#set text(
  size: 14pt,
  font: "Times New Roman",
  style: "normal"
)

#set par(
  first-line-indent: 1.25cm, // Абзацный отступ
  leading: 1.5em, // Межстрочный интервал
  spacing: 1.5em, // Интервал между параграфами
  justify: true, // Выравнивание по ширине
)

#set list(
  marker: "-",
)

#show list.item: it => {
  par[
    #list.marker#sym.space.nobreak.narrow#sym.space.nobreak.narrow#sym.space.nobreak.narrow#sym.space.nobreak.narrow#it.body\
  ] 
}

// #set par.line(numbering: "1")


#set heading(numbering: (..ns) => {
  let level = ns.pos().len()
  if(level == 1){
    none
  }
  else{
    counter(heading).display("1.1").slice(2)
  }
})


#show heading: it => {
    set text(
      size: 14pt,
      font: "Times New Roman",
      weight: "medium",
      style: "normal"
    )

    if(it.level == 1){
        set align(center)
        text(upper(it.body))
    } else {
        set align(left)
       [#counter(heading).display(it.numbering) #text(it.body)] 
    }
}





// #align(center)[#upper[Содержание]]
// #outline(title: none)
#outline(title: "Содержание")

